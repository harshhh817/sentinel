{
  "_comment": "Static RBAC/ABAC entitlement for local mode. Evaluated FIRST; a denial here is final regardless of R (Table III note).",
  "default_role": "user",
  "principals": {
    "_comment": "principal -> {role, unit}. Unknown principals get default_role and no unit.",
    "AAM0658": {"role": "ITAdmin", "unit": "research"},
    "CDE1846": {"role": "user", "unit": "sales"}
  },
  "roles": {
    "user": {
      "allow": [
        {"actions": ["sts:AssumeRole", "sts:SessionEnd"], "resources": ["arn:aws:iam::*:role/*"]},
        {"actions": ["s3:GetObject", "s3:PutObject"], "resources": ["arn:aws:s3:::sentinel-*/*"],
         "condition": {"own_unit_bucket": true}},
        {"actions": ["execute-api:Invoke"], "resources": ["arn:aws:execute-api:::*"]}
      ]
    },
    "ITAdmin": {
      "allow": [
        {"actions": ["sts:*"], "resources": ["arn:aws:iam::*"]},
        {"actions": ["s3:*"], "resources": ["arn:aws:s3:::*"]},
        {"actions": ["execute-api:Invoke"], "resources": ["arn:aws:execute-api:::*"]}
      ]
    }
  },
  "sensitivity": {
    "_comment": "Sens(rho) for eq. (4): first matching pattern wins.",
    "rules": [
      {"pattern": "arn:aws:s3:::*/removable/*", "value": 1.0},
      {"pattern": "arn:aws:s3:::*/customer/*", "value": 1.0},
      {"pattern": "arn:aws:execute-api:::*", "value": 0.8},
      {"pattern": "arn:aws:s3:::*", "value": 0.6},
      {"pattern": "arn:aws:iam::*", "value": 0.3}
    ],
    "default": 0.5
  }
}
